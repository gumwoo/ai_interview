<?xml version="1.0" encoding="utf-8"?>
<!-- 서버 주소와 암호화된 토큰을 클라우드 백업이나 기기 이전으로 내보내지 않는다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
